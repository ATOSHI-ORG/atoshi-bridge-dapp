# ─────────────────────────────────────────────────────────────────────────────
# 数据来源 —— 这一项配错的后果最严重，放在最前面
# ─────────────────────────────────────────────────────────────────────────────
# 不填、或填任何非 "mock" 的值 = 连真链。
#
# ⚠️ 只有显式写 mock 才进演示模式，而演示模式会**编造交易哈希**并把跨链流程
#    走完打上「已完成」，界面上和真链毫无区别。
#
#    这个默认值曾经是 mock，一次部署忘了改就让测试同学看到「跨链成功」——
#    而链上什么都没发生（页面给的两个哈希在 Atoshi 和 Sepolia 上都查不到，
#    抵押金库余额和 lockedAmount 都是 0）。
#
#    需要 mock 的场合只有一个：产品评审或 QA 要验「大额配额耗尽」「危机模式」
#    这类真链上凑不出来的 UI 分支。那时页面顶部会有橙色警示条。
# VITE_API_MODE="mock"

# ─────────────────────────────────────────────────────────────────────────────
# 部署路径
# ─────────────────────────────────────────────────────────────────────────────
# 只能出现一次。重复的话后面那个生效（实测 vite loadEnv 的行为），
# 而两行不一致时很容易看错前面那个。
#
#   部署在子域名根目录：留空
#   部署在子路径：      BASE_PATH="/atoshi-bridge/"
#
# 首尾都要有斜杠，且必须和 nginx 的 location / try_files 完全一致。
# 设错的症状是白屏 + "MIME type ('text/html')"，那个报错和真实原因不沾。
BASE_PATH="/atoshi-bridge/"

# ─────────────────────────────────────────────────────────────────────────────
# Atoshi 侧
# ─────────────────────────────────────────────────────────────────────────────
# Cosmos REST（app.toml 的 [api]，默认 1317），不是 EVM JSON-RPC（8545）
# 也不是 CometBFT RPC（26657）。末尾斜杠有无都可以，代码里会剥掉。
#
# 自检（返回 JSON 就对了）：
#   curl <这个地址>/atoshi/bridgeadapter/v1/params
VITE_REST_URL="https://rpc-testnet.atoshi.org/rest-api"

VITE_ATOSHI_EVM_RPC="https://rpc-testnet.atoshi.org"
VITE_ATOSHI_CHAIN_ID="88288"
VITE_ATOSHI_EXPLORER="https://explorer-testnet.atoshi.org"

# ─────────────────────────────────────────────────────────────────────────────
# 以太坊侧
# ─────────────────────────────────────────────────────────────────────────────
# chain id 同时是 Hyperlane domain id，必须和链上 bridgeadapter 参数里的
# ethereum_domain 一致，否则跨链消息会被目标链拒掉。
# 链上现在是 11155111（治理提案已通过并回读确认），和这里一致。
VITE_ETH_CHAIN_ID="11155111"

# 留空会用 viem 内置公共端点，有速率限制。填一个自己的。
VITE_ETH_RPC_URL="https://sepolia.gateway.tenderly.co"

# 以太坊侧的两个合约，都已部署并在链上逐项核对过
# （见 Atoshi-ETH-Contract/deployments/sepolia.md）。
#   ERC20_ATOS  = ERC20 ATOS（主网那份的 solc 0.4.26 复刻件）
#   COLLATERAL  = AtosCollateral —— 我们自己的桥金库，不是 Hyperlane 的
#                 HypERC20Collateral。上游那个的 quoteGasPayment 走 IGP，
#                 而 Sepolia 官方 IGP 对 domain 88288 直接 revert。
VITE_ERC20_ATOS_ADDRESS="0x1bC209c36c3696957B014250Ca38e72079341417"
VITE_COLLATERAL_ADDRESS="0xB078d5Dca45dC6B40be28Cbad9CB87A1518f0974"

# 基础单位。1 ATOS = 10^18 liao
VITE_BOND_DENOM="liao"
