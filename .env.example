# ─────────────────────────────────────────────────────────────────────────────
# 数据来源
# ─────────────────────────────────────────────────────────────────────────────
# mock  = 模拟数据 + 跨链状态机模拟 + 五层限流的各种边缘场景（setScenario）
#         产品评审和 QA 验证 UI 分支只能用这个 —— 真链上凑不出「大额配额耗尽」
#         「危机模式」这些状态。
# chain = 连真链。注意桥出目前不可用，见 README。
VITE_API_MODE="mock"

# ─────────────────────────────────────────────────────────────────────────────
# Atoshi 侧
# ─────────────────────────────────────────────────────────────────────────────
# Cosmos REST（LCD）。桥的参数、migration_pool 流动性都从这里读。
#
# ⚠️ 要的是节点 app.toml 里 [api] 暴露的端口（默认 1317），
#    不是 EVM JSON-RPC（8545），也不是 CometBFT RPC（26657）。
#
# 自检（返回 JSON 就对了）：
#   curl <这个地址>/atoshi/bridgeadapter/v1/params
VITE_REST_URL="https://rpc-testnet.atoshi.org/rest-api"

# Atoshi 的 EVM JSON-RPC 和 chain id。
# chain id 同时也是 Atoshi 的 Hyperlane domain id。
VITE_ATOSHI_EVM_RPC="https://rpc-testnet.atoshi.org"
VITE_ATOSHI_CHAIN_ID="88288"
VITE_ATOSHI_EXPLORER="https://explorer-testnet.atoshi.org"

# ─────────────────────────────────────────────────────────────────────────────
# 以太坊侧
# ─────────────────────────────────────────────────────────────────────────────
# chain id 同时也是 Hyperlane domain id。
#
# ⚠️ 必须和链上 bridgeadapter 参数里的 ethereum_domain 一致。
#    不一致的话跨链消息会被目标链拒掉。
#    测试网 11155111（Sepolia），主网 1。
#    注意：链上现在的 ethereum_domain 还是 1（创世默认值），
#    要等治理提案改成 11155111，见 README。
VITE_ETH_CHAIN_ID="11155111"

# 留空会用 viem 内置的公共端点，有速率限制。生产要自己配（Alchemy / Infura）。
VITE_ETH_RPC_URL=""

# 以太坊侧的两个合约地址。**都还没部署**，所以留空。
# 留空时桥入会给出「合约未部署」的明确提示，而不是走到一个看不懂的 revert。
#   ERC20_ATOS  = 以太坊上的 ERC20 ATOS
#   COLLATERAL  = Hyperlane HypERC20Collateral（桥入的金库）
VITE_ERC20_ATOS_ADDRESS=""
VITE_COLLATERAL_ADDRESS=""

# ─────────────────────────────────────────────────────────────────────────────
# 兜底地址（只用于没连钱包时的只读展示）
# ─────────────────────────────────────────────────────────────────────────────
VITE_DEMO_ATOSHI_ADDRESS=""
VITE_DEMO_ETH_ADDRESS=""

# 质押币最小单位。1 ATOS = 10^18 liao
VITE_BOND_DENOM="liao"
